# =============================================================================
# QuickClip - Git Ignore Configuration
# =============================================================================

# =============================================================================
# Python
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# =============================================================================
# Qt / PySide6
# =============================================================================

# Qt Creator
*.user
*.user.*
*.qmlc
*.jsc
*.ui.autosave

# Qt build artifacts
moc_*.cpp
qrc_*.cpp
ui_*.h
*.app/

# =============================================================================
# IDE / Editor
# =============================================================================

# VS Code
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.ipr
*.iws
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*.swn
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# =============================================================================
# Operating System
# =============================================================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# =============================================================================
# Project Specific
# =============================================================================

# QuickClip data file (user data - should not be in repo)
.quickclip_history.json

# Test output
test_output/
test_results/
.test_quickclip/

# Temporary files
*.tmp
*.temp
*.bak
*.backup
*.orig

# Generated images (keep branding folder contents)
!branding/*.png
!branding/*.jpg
!branding/*.svg

# Log files
*.log
logs/

# Build artifacts
*.exe
*.msi
*.dmg
*.deb
*.rpm

# =============================================================================
# Secrets / Credentials
# =============================================================================

# Environment files with secrets
.env.local
.env.*.local
*.pem
*.key
secrets.json
credentials.json

# =============================================================================
# End of .gitignore
# =============================================================================
